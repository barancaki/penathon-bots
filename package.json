{
  "name": "penathon-bots",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "Persistent local AI teammates powered by Claude Code and Codex",
  "license": "Apache-2.0",
  "author": "Baran Çakı <baran@penathon.co> (https://penathon.co)",
  "homepage": "https://github.com/barancaki/penathon-bots#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/barancaki/penathon-bots.git"
  },
  "bugs": "https://github.com/barancaki/penathon-bots/issues",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-engines.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.js *.md",
    "dev:ui": "electron-vite dev --rendererOnly",
    "icons": "node scripts/build-icons.mjs",
    "prebuild": "npm run icons",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openai/codex-sdk": "0.165.0",
    "chokidar": "6.0.0",
    "gray-matter": "4.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
